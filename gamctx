#!/bin/sh
set -eu

GAM_DIR="$HOME/.gam"
CONFIGS_DIR="$HOME/.gam-configs"

err() { echo "Error: $1" >&2; }

get_config_info() {
    _cfg="$CONFIGS_DIR/$1/gam.cfg"
    if [ ! -f "$_cfg" ]; then
        echo "unconfigured"
        return
    fi
    _domain="" _admin="" _customer=""
    while IFS='=' read -r key val; do
        key="${key#"${key%%[! ]*}"}"
        key="${key%"${key##*[! ]}"}"
        val="${val#"${val%%[! ]*}"}"
        val="${val%"${val##*[! ]}"}"
        case "$key" in
            domain) _domain="$val" ;;
            admin_email) _admin="$val" ;;
            customer_id) _customer="$val" ;;
        esac
    done < "$_cfg"
    _parts=""
    for _p in "$_domain" "$_admin" "$_customer"; do
        [ -n "$_p" ] && _parts="${_parts:+$_parts / }$_p"
    done
    echo "${_parts:-unconfigured}"
}

show_gam_init_hint() {
    echo
    echo "If GAM is not yet configured, initialize it with:"
    echo "  gam oauth create"
}

validate_name() {
    if [ -z "$1" ]; then
        err "Name cannot be empty."
        return 1
    fi
    if [ "$1" = "." ] || [ "$1" = ".." ]; then
        err "Invalid name '$1'. Names may only contain letters, numbers, hyphens, and underscores."
        return 1
    fi
    case "$1" in
        -*)
            err "Invalid name '$1'. Names may not start with a hyphen."
            return 1
            ;;
    esac
    if [ ${#1} -gt 64 ]; then
        err "Invalid name '$1'. Names must be 64 characters or less."
        return 1
    fi
    case "$1" in
        *[!a-zA-Z0-9_-]*)
            err "Invalid name '$1'. Names may only contain letters, numbers, hyphens, and underscores."
            return 1
            ;;
    esac
    return 0
}

require_configs_dir() {
    if [ ! -d "$CONFIGS_DIR" ]; then
        err "Not initialized. Run 'gamctx init' first."
        return 1
    fi
}

list_configs() {
    find "$CONFIGS_DIR" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort
}

switch_to() {
    ln -sfn ".gam-configs/$1" "$GAM_DIR"
    echo "Switched to $1 ($(get_config_info "$1"))"
}

get_current() {
    if [ ! -L "$GAM_DIR" ]; then
        return 1
    fi
    _target=$(readlink "$GAM_DIR")
    _basename=$(basename "$CONFIGS_DIR")
    case "$_target" in
        "$_basename"/*)
            basename "$_target"
            return 0
            ;;
    esac
    return 1
}

cmd_help() {
    cat <<EOF
Usage: gamctx <command> [args]

Commands:
  init [name]         Adopt existing ~/.gam into managed structure (default: default)
  add <name>          Create new empty configuration
  use [name]          Switch configuration (interactive if no name)
  list                List all configurations
  current             Show current configuration
  move <old> <new>    Move/rename a configuration
  copy <src> <dest>   Copy a configuration
  help                Show this help
EOF
}

cmd_init() {
    name="${1:-default}"
    validate_name "$name" || return 1

    if [ -L "$GAM_DIR" ]; then
        _target=$(readlink "$GAM_DIR")
        _basename=$(basename "$CONFIGS_DIR")
        case "$_target" in
            "$_basename"/*)
                echo "Already initialized"
                return 0
                ;;
            *)
                err "\$HOME/.gam is a symlink to $_target"
                return 1
                ;;
        esac
    fi

    mkdir -p "$CONFIGS_DIR"

    if [ -d "$GAM_DIR" ] && [ ! -L "$GAM_DIR" ]; then
        mv "$GAM_DIR" "$CONFIGS_DIR/$name"
        echo "Moved ~/.gam to ~/.gam-configs/$name/"
    else
        mkdir -p "$CONFIGS_DIR/$name"
    fi

    switch_to "$name"
    show_gam_init_hint
}

cmd_add() {
    name="${1:-}"
    validate_name "$name" || return 1

    if [ -d "$CONFIGS_DIR/$name" ]; then
        err "Configuration '$name' already exists."
        return 1
    fi

    mkdir -p "$CONFIGS_DIR/$name"
    echo "Created ~/.gam-configs/$name/"
    show_gam_init_hint
}

cmd_use() {
    name="${1:-}"
    require_configs_dir || return 1

    if [ -z "$name" ]; then
        configs=$(list_configs)

        if [ -z "$configs" ]; then
            err "No configurations found."
            return 1
        fi

        config_count=$(printf '%s\n' "$configs" | wc -l)

        if [ "$config_count" -eq 1 ]; then
            name="$configs"
        else
            printf '%s\n' "$configs" | awk '{print NR") "$0}'
            while true; do
                printf '#? '
                read -r choice
                name=$(printf '%s\n' "$configs" | sed -n "${choice}p")
                if [ -n "$name" ]; then
                    break
                fi
            done
        fi
    else
        validate_name "$name" || return 1
    fi

    if [ ! -d "$CONFIGS_DIR/$name" ]; then
        err "Configuration '$name' does not exist."
        return 1
    fi

    switch_to "$name"
    show_gam_init_hint
}

cmd_list() {
    require_configs_dir || return 1

    current=$(get_current) || current=""

    configs=$(list_configs)

    if [ -z "$configs" ]; then
        err "No configurations found."
        return 1
    fi

    printf '%s\n' "$configs" | while IFS= read -r cfg; do
        if [ "$cfg" = "$current" ]; then
            echo "* $cfg ($(get_config_info "$cfg"))"
        else
            echo "  $cfg ($(get_config_info "$cfg"))"
        fi
    done
}

cmd_current() {
    require_configs_dir || return 1

    if current=$(get_current); then
        echo "$current"
    else
        err "\$HOME/.gam is not managed by gamctx."
        return 1
    fi
}

cmd_move() {
    old_name="${1:-}"
    new_name="${2:-}"
    require_configs_dir || return 1

    if [ -z "$old_name" ] || [ -z "$new_name" ]; then
        err "Both old and new names are required."
        return 1
    fi

    validate_name "$old_name" || return 1
    validate_name "$new_name" || return 1

    if [ ! -d "$CONFIGS_DIR/$old_name" ]; then
        err "Configuration '$old_name' does not exist."
        return 1
    fi

    if [ -d "$CONFIGS_DIR/$new_name" ]; then
        err "Configuration '$new_name' already exists."
        return 1
    fi

    mv "$CONFIGS_DIR/$old_name" "$CONFIGS_DIR/$new_name"

    current=$(get_current) || current=""
    if [ "$current" = "$old_name" ]; then
        switch_to "$new_name"
    fi

    echo "Moved $old_name → $new_name"
}

cmd_copy() {
    src_name="${1:-}"
    dest_name="${2:-}"
    require_configs_dir || return 1

    if [ -z "$src_name" ] || [ -z "$dest_name" ]; then
        err "Both source and destination names are required."
        return 1
    fi

    validate_name "$src_name" || return 1
    validate_name "$dest_name" || return 1

    if [ ! -d "$CONFIGS_DIR/$src_name" ]; then
        err "Configuration '$src_name' does not exist."
        return 1
    fi

    if [ -d "$CONFIGS_DIR/$dest_name" ]; then
        err "Configuration '$dest_name' already exists."
        return 1
    fi

    cp -r "$CONFIGS_DIR/$src_name" "$CONFIGS_DIR/$dest_name"

    echo "Copied $src_name → $dest_name"
}

case "${1:-}" in
    init) shift; cmd_init "$@" ;;
    add) shift; cmd_add "$@" ;;
    use) shift; cmd_use "$@" ;;
    list) cmd_list ;;
    current) cmd_current ;;
    move) shift; cmd_move "$@" ;;
    copy) shift; cmd_copy "$@" ;;
    help|--help|-h) cmd_help ;;
    "") cmd_use ;;
    *) err "Unknown command: $1"; cmd_help >&2; exit 1 ;;
esac
