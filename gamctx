#!/usr/bin/env bash
set -euo pipefail

GAM_DIR="$HOME/.gam"
CONFIGS_DIR="$HOME/.gam-configs"

err() { echo "Error: $1" >&2; }

validate_name() {
    local name="$1"
    if [ -z "$name" ]; then
        err "Name cannot be empty."
        return 1
    fi
    if [ "$name" = "." ] || [ "$name" = ".." ]; then
        err "Invalid name '$name'. Names may only contain letters, numbers, hyphens, and underscores."
        return 1
    fi
    case "$name" in
        -*)
            err "Invalid name '$name'. Names may not start with a hyphen."
            return 1
            ;;
    esac
    if [ ${#name} -gt 64 ]; then
        err "Invalid name '$name'. Names must be 64 characters or less."
        return 1
    fi
    case "$name" in
        *[!a-zA-Z0-9_-]*)
            err "Invalid name '$name'. Names may only contain letters, numbers, hyphens, and underscores."
            return 1
            ;;
    esac
    return 0
}

require_configs_dir() {
    if [ ! -d "$CONFIGS_DIR" ]; then
        err "Not initialized. Run 'gamctx init' first."
        return 1
    fi
}

get_current() {
    if [ ! -L "$GAM_DIR" ]; then
        return 1
    fi
    local target
    target=$(readlink "$GAM_DIR")
    local configs_basename
    configs_basename=$(basename "$CONFIGS_DIR")
    case "$target" in
        "$configs_basename"/*)
            basename "$target"
            return 0
            ;;
    esac
    return 1
}

cmd_help() {
    cat <<EOF
Usage: gamctx <command> [args]

Commands:
  init [name]    Adopt existing ~/.gam into managed structure (default: default)
  add <name>     Create new empty configuration
  use [name]     Switch configuration (interactive if no name)
  list           List all configurations
  current        Show current configuration
  help           Show this help
EOF
}

cmd_init() {
    local name="${1:-default}"
    validate_name "$name" || return 1

    if [ -L "$GAM_DIR" ]; then
        local target
        target=$(readlink "$GAM_DIR")
        local configs_basename
        configs_basename=$(basename "$CONFIGS_DIR")
        case "$target" in
            "$configs_basename"/*)
                echo "Already initialized"
                return 0
                ;;
            *)
                err "\$HOME/.gam is a symlink to $target"
                return 1
                ;;
        esac
    fi

    mkdir -p "$CONFIGS_DIR"

    if [ -d "$GAM_DIR" ] && [ ! -L "$GAM_DIR" ]; then
        mv "$GAM_DIR" "$CONFIGS_DIR/$name"
        echo "Moved ~/.gam to ~/.gam-configs/$name/"
    else
        mkdir -p "$CONFIGS_DIR/$name"
    fi

    ln -sfn ".gam-configs/$name" "$GAM_DIR"
    echo "Switched to $name"
}

cmd_add() {
    local name="${1:-}"
    validate_name "$name" || return 1

    if [ -d "$CONFIGS_DIR/$name" ]; then
        err "Configuration '$name' already exists."
        return 1
    fi

    mkdir -p "$CONFIGS_DIR/$name"
    echo "Created ~/.gam-configs/$name/"
    echo "Run 'gam select' to authenticate and set up this configuration"
}

cmd_use() {
    local name="${1:-}"
    require_configs_dir || return 1

    if [ -z "$name" ]; then
        local configs
        configs=$(find "$CONFIGS_DIR" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort)

        if [ -z "$configs" ]; then
            err "No configurations found."
            return 1
        fi

        local config_count
        config_count=$(printf '%s\n' "$configs" | wc -l)

        if [ "$config_count" -eq 1 ]; then
            name="$configs"
        else
            printf '%s\n' "$configs" | awk '{print NR") "$0}'
            while true; do
                printf '#? '
                read -r choice
                name=$(printf '%s\n' "$configs" | sed -n "${choice}p")
                if [ -n "$name" ]; then
                    break
                fi
            done
        fi
    else
        validate_name "$name" || return 1
    fi

    if [ ! -d "$CONFIGS_DIR/$name" ]; then
        err "Configuration '$name' does not exist."
        return 1
    fi

    ln -sfn ".gam-configs/$name" "$GAM_DIR"
    echo "Switched to $name"
}

cmd_list() {
    require_configs_dir || return 1

    local current=""
    current=$(get_current) || true

    local configs
    configs=$(find "$CONFIGS_DIR" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort)

    if [ -z "$configs" ]; then
        err "No configurations found."
        return 1
    fi

    printf '%s\n' "$configs" | while IFS= read -r cfg; do
        if [ "$cfg" = "$current" ]; then
            echo "* $cfg"
        else
            echo "  $cfg"
        fi
    done
}

cmd_current() {
    require_configs_dir || return 1

    local current
    if current=$(get_current); then
        echo "$current"
    else
        err "\$HOME/.gam is not managed by gamctx."
        return 1
    fi
}

case "${1:-}" in
    init) shift; cmd_init "$@" ;;
    add) shift; cmd_add "$@" ;;
    use) shift; cmd_use "$@" ;;
    list) cmd_list ;;
    current) cmd_current ;;
    help|--help|-h) cmd_help ;;
    "") cmd_use ;;
    *) err "Unknown command: $1"; cmd_help >&2; exit 1 ;;
esac
